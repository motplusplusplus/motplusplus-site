{
  "name": "motplus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-bios.mjs",
    "build": "next build --webpack",
    "build:cf": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint",
    "validate": "node scripts/check-no-body-truncation.mjs && node scripts/check-event-active.mjs && node scripts/validate-sanity-images.mjs",
    "check:bios": "node scripts/check-bios.mjs",
    "check:no-truncation": "node scripts/check-no-body-truncation.mjs",
    "check:event-active": "node scripts/check-event-active.mjs",
    "verify-deploy": "node scripts/verify-deploy.js",
    "verify-content": "node scripts/verify-content.js",
    "purge-cache": "node scripts/purge-cache.js",
    "prewarm-images": "node scripts/prewarm-images.mjs",
    "deploy": "node scripts/deploy.js",
    "test:devices": "cd tests/devices && (test -d node_modules || npm install --silent) && node run.mjs",
    "test:thirdparty": "cd tests/devices && (test -d node_modules || npm install --silent) && node thirdparty.mjs"
  },
  "dependencies": {
    "@portabletext/react": "^6.2.0",
    "@sanity/client": "^7.20.0",
    "@types/mapbox-gl": "^3.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "mapbox-gl": "^3.20.0",
    "next": "16.1.6",
    "photoswipe": "^5.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.17.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.100.0"
  }
}
